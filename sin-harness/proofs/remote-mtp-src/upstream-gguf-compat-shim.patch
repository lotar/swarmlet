+// --- compatibility shim (lab only): accept PR-era Qwen4Exp GGUF names produced by the local patch script ---
+// metadata keys: upstream name -> name present in the patched file
+static std::string llama_compat_kv_alias(const gguf_context * ctx, const std::string & key) {
+    if (gguf_find_key(ctx, key.c_str()) >= 0) return key;
+    static const std::pair<const char *, const char *> aliases[] = {
+        {".hyper_connection.low_rank", ".hyper_connection.lowrank"},
+        {".ple.layer_multipliers",     ".ple.ngram_multipliers"},
+        {".ple.head_offsets",          ".ple.ngram_offsets"},
+        {".ple.head_vocab_sizes",      ".ple.ngram_vocab_sizes"},
+    };
+    for (const auto & a : aliases) {
+        const std::string from = a.first;
+        if (key.size() > from.size() && key.compare(key.size() - from.size(), from.size(), from) == 0) {
+            const std::string alt = key.substr(0, key.size() - from.size()) + a.second;
+            if (gguf_find_key(ctx, alt.c_str()) >= 0) return alt;
+        }
+    }
+    return key;
+}
+// tensor names: upstream name -> name present in the patched file (PLE layer index is unknown here, so match by suffix)
+static std::string llama_compat_tensor_alias(const std::string & name, const std::function<bool(const std::string &)> & exists) {
+    if (exists(name)) return name;
+    // per_layer_token_embd.weight -> blk.N.ple_ngram_embd.weight (N = the single PLE layer)
+    if (name == "per_layer_token_embd.weight") {
+        for (int n = 0; n < 128; ++n) { const std::string alt = "blk." + std::to_string(n) + ".ple_ngram_embd.weight"; if (exists(alt)) return alt; }
+    }
+    static const std::pair<const char *, const char *> suffixes[] = {
+        {".ple_norm_key.weight",   ".ple_key_norm.weight"},
+        {".ple_norm_query.weight", ".ple_query_norm.weight"},
+        {".ple_norm_conv.weight",  ".ple_conv_norm.weight"},
+    };
+    for (const auto & a : suffixes) {
+        const std::string from = a.first;
+        if (name.size() > from.size() && name.compare(name.size() - from.size(), from.size(), from) == 0) {
+            const std::string alt = name.substr(0, name.size() - from.size()) + a.second;
+            if (exists(alt)) return alt;
+        }
+    }
+    return name;
+}
