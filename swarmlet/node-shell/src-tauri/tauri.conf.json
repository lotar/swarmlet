{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarmlet Node",
  "version": "0.1.0",
  "identifier": "ai.swarmlet.node",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Swarmlet node agent",
    "longDescription": "Desktop shell for the Swarmlet node agent: opens the local node UI, keeps a tray icon, starts at login, and runs the agent as a sidecar when no service is installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/swarmlet-node"
    ],
    "resources": {
      "binaries/engine/*": "engine/",
      "binaries/agent-build.json": "agent-build.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
