+// LAB: opt-in, silent-by-default per-message timeline for diagnosing pipelining. Off unless
+// GGML_RPC_PIPELINE_TRACE=1 is set; writes to stderr directly (not through the ggml log filter,
+// which drops LOG_LEVEL_DEBUG at the server's default verbosity) so it's actually visible when
+// asked for.
+static bool rpc_trace_enabled() {
+    static const bool v = []() {
+        const char * e = std::getenv("GGML_RPC_PIPELINE_TRACE");
+        return e != nullptr && std::string(e) == "1";
+    }();
+    return v;
