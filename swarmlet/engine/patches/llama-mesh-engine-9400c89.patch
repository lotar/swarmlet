+static void start_peer_listener(rpc_peer_hub * hub, const std::string & host, int port) {
+    auto server_socket = socket_t::create_server(host.c_str(), port);
+    if (server_socket == nullptr) {
+        fprintf(stderr, "Failed to create peer listener socket on %s:%d\n", host.c_str(), port);
+        return;
+    }
+    printf("Peer listener on %s:%d\n", host.c_str(), port);
+    fflush(stdout);
+    while (true) {
+        auto peer_socket = server_socket->accept();
+        if (peer_socket == nullptr) {
+            fprintf(stderr, "Failed to accept peer connection\n");
+            return;
+        }
+        // Detached: each peer connection lives for the server process's lifetime (a source
+        // server opens it once, lazily, and reuses it -- see rpc_peer_hub::push), so there is no
+        // natural join point short of process exit.
+        std::thread(rpc_peer_conn_loop, hub, peer_socket).detach();
+    }
+}
