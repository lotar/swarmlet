+static std::string llama_compat_kv_alias(const gguf_context * ctx, const std::string & key) {
+    if (gguf_find_key(ctx, key.c_str()) >= 0) return key;
+    static const std::pair<const char *, const char *> aliases[] = {
+        {".hyper_connection.low_rank", ".hyper_connection.lowrank"},
+        {".ple.layer_multipliers",     ".ple.ngram_multipliers"},
+        {".ple.head_offsets",          ".ple.ngram_offsets"},
+        {".ple.head_vocab_sizes",      ".ple.ngram_vocab_sizes"},
+    };
+    for (const auto & a : aliases) {
+        const std::string from = a.first;
+        if (key.size() > from.size() && key.compare(key.size() - from.size(), from.size(), from) == 0) {
+            const std::string alt = key.substr(0, key.size() - from.size()) + a.second;
+            if (gguf_find_key(ctx, alt.c_str()) >= 0) return alt;
+        }
+    }
