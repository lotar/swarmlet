+static void rpc_wire_trace(const char * kind, const void * who, const char * name, uint32_t type,
+                           const int64_t * ne, uint64_t offset, uint64_t raw, uint8_t wire, uint64_t enc) {
+    TRACE_MSG("[%p] WIRE %s name=%.*s type=%s ne=[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "] off=%" PRIu64 " raw=%" PRIu64 " mode=%s enc=%" PRIu64 "\n",
+              who, kind, GGML_MAX_NAME, name, ggml_type_name((ggml_type) type), ne[0], ne[1], ne[2], ne[3], offset, raw, rpc_wire_name(wire), enc);
+}
+
+// Same, for a serialized rpc_tensor (server side).
+static void rpc_wire_trace_rt(const char * kind, const void * who, const rpc_tensor & t, uint64_t offset, uint64_t raw, uint8_t wire, uint64_t enc) {
+    const int64_t ne[GGML_MAX_DIMS] = { t.ne[0], t.ne[1], t.ne[2], t.ne[3] };
+    rpc_wire_trace(kind, who, t.name, t.type, ne, offset, raw, wire, enc);
