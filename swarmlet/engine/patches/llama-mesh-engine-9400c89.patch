+rpc_server::stored_graph * rpc_server::find_stored_graph(uint32_t device, uint64_t uid) {
+    auto & graphs = stored_graphs_per_device[device];
+    for (size_t i = 0; i < graphs.size(); i++) {
+        if (graphs[i].uid == uid) {
+            if (i + 1 != graphs.size()) {
+                // move to back (most recently used) -- keeps eviction order in sync with the
+                // client's rpc_graph_uid_lru, which does the same on a cache hit
+                stored_graph moved = std::move(graphs[i]);
+                graphs.erase(graphs.begin() + i);
+                graphs.push_back(std::move(moved));
+            }
+            return &graphs.back();
+        }
+    }
+    return nullptr;
+}
