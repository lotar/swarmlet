+bool rpc_server::forward_read_src(const rpc_tensor & src, uint64_t seq, uint32_t peer, std::vector<uint8_t> & data) {
+    if (peer_hub == nullptr) {
+        GGML_LOG_ERROR("[%s] server was not started with --peer support\n", __func__);
+        return false;
+    }
+
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_context * ctx = ctx_ptr.get();
+    // `src` is in THIS server's own buffer namespace (see ggml_backend_rpc_cpy_tensor_async, which
+    // serializes it with this server's dispatcher) -- deserialize and bounds-check it exactly like
+    // get_tensor() does.
+    ggml_tensor * tensor = deserialize_tensor(ctx, &src);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        GGML_LOG_ERROR("[%s] error deserializing src tensor\n", __func__);
+        return false;
+    }
+    const uint64_t size = (uint64_t) ggml_nbytes(tensor);
+    LOG_DBG("[%s] seq: %" PRIu64 ", peer: %u, buffer: %p, data: %p, size: %" PRIu64 "\n",
+            __func__, seq, peer, (void*)tensor->buffer, tensor->data, size);
+
+    // sanitize tensor->data (whole-tensor read, offset 0 -- unlike get_tensor() there is no
+    // client-supplied offset/size to validate against a sub-range, but the tensor itself must
+    // still fit inside its buffer)
+    {
+        const size_t p0 = (size_t) ggml_backend_buffer_get_base(tensor->buffer);
+        const size_t p1 = p0 + ggml_backend_buffer_get_size(tensor->buffer);
+        if (src.data < p0 || src.data >= p1 || size > (p1 - src.data)) {
+            GGML_LOG_ERROR("[%s] src tensor region (data=0x%" PRIx64 ", size=%" PRIu64 ") out of buffer bounds [0x%zx, 0x%zx)\n",
+                           __func__, src.data, size, p0, p1);
+            return false;
+        }
+    }
+
+    data.resize(size);
+    ggml_backend_tensor_get(tensor, data.data(), 0, size);
+    return true;
+}
