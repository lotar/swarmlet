+// Builds an RPC_CMD_SET_TENSOR_WIRE payload for `size` raw bytes of `data` (format: see above).
+static std::shared_ptr<uint8_t> rpc_build_set_tensor_wire(const rpc_tensor & rt, const void * data, uint64_t offset, uint64_t size, uint8_t wire, size_t * input_size) {
+    const size_t enc_size = rpc_wire_encoded_size(wire, size);
+    *input_size = RPC_SET_TENSOR_WIRE_HDR + enc_size;
+    uint8_t * input = new uint8_t[*input_size];
+    uint8_t * p = input;
+    memcpy(p, &rt, sizeof(rt));           p += sizeof(rt);
+    memcpy(p, &offset, sizeof(offset));   p += sizeof(offset);
+    *p++ = wire;
+    memcpy(p, &size, sizeof(size));       p += sizeof(size);
+    rpc_wire_encode(wire, data, size, p);
+    return std::shared_ptr<uint8_t>(input, std::default_delete<uint8_t[]>());
+}
