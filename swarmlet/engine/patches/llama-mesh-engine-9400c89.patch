diff --git a/tools/ring-bench/ring-bench.cpp b/tools/ring-bench/ring-bench.cpp
new file mode 100644
index 0000000..7bbc431
--- /dev/null
+++ b/tools/ring-bench/ring-bench.cpp
@@ -0,0 +1,322 @@
+// llama-ring-bench: multi-stream benchmark for the RPC dispatcher.
+//
+// Loads one model, opens `--streams N` separate llama_context objects against it (context 0 via
+// common_init_from_params, 1..N-1 via llama_init_from_model with the same params), and runs each
+// stream's prompt + greedy generation on its own std::thread, started together via a barrier.
+// All streams that touch the same --rpc endpoint share ggml-rpc's per-process rpc_dispatcher
+// (see get_dispatcher() in ggml-rpc.cpp) and its one TCP connection per endpoint, so this is the
+// tool that can actually show whether GGML_RPC_PIPELINE=1 (writer/reader split, no head-of-line
+// blocking on the shared socket) beats the default single-threaded dispatcher when multiple
+// contexts contend for it, as opposed to the single-stream case where there's nothing to overlap.
+
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+
+#define JSON_ASSERT GGML_ASSERT
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+using json = nlohmann::ordered_json;
+using clock_type = std::chrono::steady_clock;
+
+static double ms_since(clock_type::time_point t0) {
+    return std::chrono::duration<double, std::milli>(clock_type::now() - t0).count();
+}
+
+// fixed prompt list, cycled if --streams > 8
+static const std::vector<std::string> kPrompts = {
+    "Write a Python binary search function and one test.",
+    "Explain speculative decoding in four sentences.",
+    "Solve: 17*23. Explain briefly.",
+    "Return minified JSON: country of Zagreb and confidence.",
+    "List three prime numbers above 100 and why they are prime.",
+    "Describe a Wi-Fi power-save bug in two sentences.",
+    "Write a haiku about latency.",
+    "Give the SI unit of inductance and one use.",
+};
+
+struct stream_result {
+    int                      stream_id = 0;
+    std::string              prompt;
+    std::vector<llama_token> prompt_tokens;
+    std::vector<llama_token> gen_tokens;
+    std::string              gen_text;
+    double                   prompt_ms = 0.0;   // time to decode the prompt batch
+    std::vector<double>      per_token_ms;       // wall time for each generated token
+    bool                     ok = true;
+    std::string              error;
+};
+
+static void print_usage(int, char ** argv) {
+    LOG("\nexample usage:\n");
+    LOG("\n    %s -m model.gguf --rpc host:port[,host:port...] --device RPC0,RPC1,MTL0 --tensor-split 1,1,2 "
+        "-ngl 999 -c 2048 -t 4 -n 48 --streams 4 --out results.json\n", argv[0]);
+    LOG("\n    --streams N   number of concurrent llama_context streams sharing the model (default 1)\n");
+    LOG("    --out FILE    path to write the JSON results (default: none, stdout summary only)\n");
+    LOG("\n");
+}
+
+// Runs one stream end to end: tokenize -> decode prompt in one batch -> greedy-argmax generate
+// -n tokens one at a time via llama_get_logits_ith(ctx, -1). No sampler, no randomness, so output
+// is directly comparable across runs (dispatcher on/off, delay on/off) byte for byte.
+static void run_stream(llama_context * ctx, const llama_vocab * vocab, int stream_id, int n_predict,
+                        std::atomic<int> * ready, int n_total, std::atomic<bool> * go, stream_result * out) {
+    out->stream_id = stream_id;
+    out->prompt    = kPrompts[stream_id % kPrompts.size()];
+
+    // tokenize before the barrier: this is local CPU work, not part of what we're timing, and
+    // doing it up front means every thread hits llama_decode() as close to "go" as possible.
+    out->prompt_tokens = common_tokenize(vocab, out->prompt, /*add_special=*/true, /*parse_special=*/true);
+    if (out->prompt_tokens.empty()) {
+        out->ok    = false;
+        out->error = "empty tokenization";
+        ready->fetch_add(1);
+        return;
+    }
+
+    // barrier: wait for every stream's thread to be ready and tokenized, then all release together
+    ready->fetch_add(1);
+    while (ready->load() < n_total) {
+        std::this_thread::yield();
+    }
+    while (!go->load()) {
+        std::this_thread::yield();
+    }
+
+    auto t_prompt0 = clock_type::now();
+    {
+        llama_batch batch = llama_batch_get_one(out->prompt_tokens.data(), (int32_t) out->prompt_tokens.size());
+        int ret = llama_decode(ctx, batch);
+        if (ret != 0) {
+            out->ok    = false;
+            out->error = "llama_decode(prompt) failed, ret=" + std::to_string(ret);
+            return;
+        }
+    }
+    out->prompt_ms = ms_since(t_prompt0);
+
+    out->gen_tokens.reserve(n_predict);
+    out->per_token_ms.reserve(n_predict);
+
+    for (int i = 0; i < n_predict; i++) {
+        auto t0 = clock_type::now();
+
+        float * logits = llama_get_logits_ith(ctx, -1);
+        if (logits == nullptr) {
+            out->ok    = false;
+            out->error = "llama_get_logits_ith returned null at step " + std::to_string(i);
+            return;
+        }
+
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        int32_t       best_id = 0;
+        float         best_v  = logits[0];
+        for (int32_t v = 1; v < n_vocab; v++) {
+            if (logits[v] > best_v) {
+                best_v  = logits[v];
+                best_id = v;
+            }
+        }
+        llama_token next = (llama_token) best_id;
+
+        out->gen_tokens.push_back(next);
+        out->gen_text += common_token_to_piece(vocab, next, /*special=*/false);
+
+        llama_batch batch = llama_batch_get_one(&next, 1);
+        int ret = llama_decode(ctx, batch);
+        if (ret != 0) {
+            out->ok    = false;
+            out->error = "llama_decode(gen) failed at step " + std::to_string(i) + ", ret=" + std::to_string(ret);
+            return;
+        }
+
+        out->per_token_ms.push_back(ms_since(t0));
+    }
+}
+
+static double median(std::vector<double> v) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    std::sort(v.begin(), v.end());
+    size_t n = v.size();
+    return (n % 2 == 1) ? v[n / 2] : (v[n / 2 - 1] + v[n / 2]) / 2.0;
+}
+
+int main(int argc, char ** argv) {
+    // custom args, stripped from argv before common_params_parse sees it (it doesn't know them).
+    // `filtered` must outlive the common_params_parse() call below since argv is repointed at
+    // its buffer -- keep it at function scope, not a nested block, or argv dangles.
+    int                  streams = 1;
+    std::string          out_path;
+    std::vector<char *>  filtered;
+    filtered.push_back(argv[0]);
+    for (int i = 1; i < argc; i++) {
+        std::string a = argv[i];
+        if (a == "--streams" && i + 1 < argc) {
+            streams = std::max(1, atoi(argv[++i]));
+            continue;
+        }
+        if (a == "--out" && i + 1 < argc) {
+            out_path = argv[++i];
+            continue;
+        }
+        filtered.push_back(argv[i]);
+    }
+    argc = (int) filtered.size();
+    argv = filtered.data();
+
+    common_params params;
+    common_init();
+
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON, print_usage)) {
+        return 1;
+    }
+
+    const int n_predict = params.n_predict > 0 ? params.n_predict : 32;
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+
+    LOG("%s: loading model, then opening %d stream%s\n", __func__, streams, streams == 1 ? "" : "s");
+
+    auto llama_init = common_init_from_params(params);
+    llama_model *   model = llama_init->model();
+    llama_context * ctx0  = llama_init->context();
+
+    if (model == nullptr || ctx0 == nullptr) {
+        LOG_ERR("%s: failed to load model / create context 0\n", __func__);
+        return 1;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    std::vector<llama_context *> ctxs;
+    ctxs.push_back(ctx0);
+
+    llama_context_params ctx_params = common_context_params_to_llama(params);
+    for (int i = 1; i < streams; i++) {
+        llama_context * c = llama_init_from_model(model, ctx_params);
+        if (c == nullptr) {
+            LOG_ERR("%s: failed to create context for stream %d\n", __func__, i);
+            // ctx0 is owned by llama_init (RAII); only free the ones we created ourselves
+            for (size_t j = 1; j < ctxs.size(); j++) {
+                llama_free(ctxs[j]);
+            }
+            return 1;
+        }
+        ctxs.push_back(c);
+    }
+
+    std::vector<stream_result> results(streams);
+    std::vector<std::thread>   threads;
+    threads.reserve(streams);
+
+    std::atomic<int>  ready(0);
+    std::atomic<bool> go(false);
+
+    for (int i = 0; i < streams; i++) {
+        threads.emplace_back(run_stream, ctxs[i], vocab, i, n_predict, &ready, streams, &go, &results[i]);
+    }
+
+    // wait until every stream has tokenized and is parked at the barrier, then release all at once
+    while (ready.load() < streams) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    auto t_wall0 = clock_type::now();
+    go.store(true);
+
+    for (auto & t : threads) {
+        t.join();
+    }
+    double wall_s = ms_since(t_wall0) / 1000.0;
+
+    bool all_ok = true;
+    for (auto & r : results) {
+        if (!r.ok) {
+            all_ok = false;
+            LOG_ERR("%s: stream %d FAILED: %s\n", __func__, r.stream_id, r.error.c_str());
+        }
+    }
+
+    int64_t total_gen_tokens = 0;
+    std::vector<double> stream_median_ms;
+    for (auto & r : results) {
+        total_gen_tokens += (int64_t) r.gen_tokens.size();
+        double med = median(r.per_token_ms);
+        stream_median_ms.push_back(med);
+        double mean_ms = 0.0;
+        for (double v : r.per_token_ms) {
+            mean_ms += v;
+        }
+        mean_ms = r.per_token_ms.empty() ? 0.0 : mean_ms / r.per_token_ms.size();
+        LOG("STREAM %d: prompt_ms %.1f, gen ms/token %.2f (%zu tokens)\n",
+            r.stream_id, r.prompt_ms, mean_ms, r.per_token_ms.size());
+    }
+
+    double aggregate_tps = wall_s > 0.0 ? (double) total_gen_tokens / wall_s : 0.0;
+    double per_stream_median_ms = median(stream_median_ms);
+
+    LOG("RESULT streams=%d aggregate_tps=%.3f per_stream_median_ms_per_token=%.3f wall_s=%.3f\n",
+        streams, aggregate_tps, per_stream_median_ms, wall_s);
+
+    if (!out_path.empty()) {
+        json j;
+        j["streams"]                          = streams;
+        j["n_predict"]                         = n_predict;
+        j["wall_s"]                            = wall_s;
+        j["aggregate_tps"]                     = aggregate_tps;
+        j["per_stream_median_ms_per_token"]    = per_stream_median_ms;
+        j["all_ok"]                            = all_ok;
+        j["pipeline_env"]                      = std::getenv("GGML_RPC_PIPELINE") ? std::getenv("GGML_RPC_PIPELINE") : "";
+        j["sched_pipelined_copy_env"]          = std::getenv("GGML_SCHED_PIPELINED_COPY") ? std::getenv("GGML_SCHED_PIPELINED_COPY") : "";
+
+        json streams_j = json::array();
+        for (auto & r : results) {
+            json sj;
+            sj["stream_id"]      = r.stream_id;
+            sj["prompt"]         = r.prompt;
+            sj["prompt_tokens"]  = r.prompt_tokens;
+            sj["prompt_ms"]      = r.prompt_ms;
+            sj["gen_tokens"]     = r.gen_tokens;
+            sj["gen_text"]       = r.gen_text;
+            sj["per_token_ms"]   = r.per_token_ms;
+            sj["ok"]             = r.ok;
+            sj["error"]          = r.error;
+            streams_j.push_back(sj);
+        }
+        j["streams_detail"] = streams_j;
+
+        std::ofstream f(out_path);
+        if (!f) {
+            LOG_ERR("%s: failed to open --out path '%s' for writing\n", __func__, out_path.c_str());
+        } else {
+            f << j.dump(1);
+            f.close();
+            LOG("%s: wrote results to %s\n", __func__, out_path.c_str());
+        }
+    }
+
+    // ctxs[0] == ctx0 is owned by llama_init (a common_init_result_ptr, RAII-wraps model + ctx 0
+    // in llama_model_ptr/llama_context_ptr unique_ptrs) -- only free the contexts we created
+    // ourselves via llama_init_from_model. Destroying llama_init frees ctx0 and the model.
+    for (size_t i = 1; i < ctxs.size(); i++) {
+        llama_free(ctxs[i]);
+    }
+    llama_init.reset();
+
+    llama_backend_free();
+
+    return all_ok ? 0 : 1;
+}
