+bool rpc_server::forward_tensor(const rpc_msg_forward_tensor_req & request) {
+    std::vector<uint8_t> data;
+    if (!forward_read_src(request.src, request.seq, request.peer, data)) {
+        return false;
+    }
+    if (!peer_hub->push(request.peer, request.seq, request.dst, data.data(), data.size())) {
+        GGML_LOG_ERROR("[%s] push to peer %u failed (seq %" PRIu64 ")\n", __func__, request.peer, request.seq);
+        return false;
+    }
+    return true;
+}
+
+// v8.1: FORWARD_TENSOR with a wire mode. Rejects (ending the connection, like any other malformed
+// request) a mode the src tensor cannot be encoded in -- a v8.1 client never asks for one (see
+// rpc_wire_pick), so that is a protocol violation rather than a case to fall back on. The push
+// itself may still go out raw if the PEER predates 8.1 (see rpc_peer_hub::push_wire).
+bool rpc_server::forward_tensor_wire(const rpc_msg_forward_tensor_wire_req & request) {
+    std::vector<uint8_t> data;
+    if (!forward_read_src(request.src, request.seq, request.peer, data)) {
+        return false;
+    }
+    if (request.wire > RPC_WIRE_Q8_0 || request.src.type != GGML_TYPE_F32 ||
+        !rpc_wire_ok(request.wire, data.size(), request.src.ne[0])) {
+        GGML_LOG_ERROR("[%s] cannot encode src (type %u, ne0=%u, %zu bytes) as wire mode %u (seq %" PRIu64 ")\n",
+                       __func__, request.src.type, request.src.ne[0], data.size(), request.wire, request.seq);
+        return false;
+    }
+    if (!peer_hub->push_wire(request.peer, request.seq, request.dst, request.wire, data.data(), data.size())) {
+        GGML_LOG_ERROR("[%s] push to peer %u failed (seq %" PRIu64 ")\n", __func__, request.peer, request.seq);
+        return false;
+    }
+    return true;
+}
+
+// v8.1: same validation + read as get_tensor() (delegated to it), reply encoded per request.wire.
+bool rpc_server::get_tensor_wire(const rpc_msg_get_tensor_wire_req & request, std::vector<uint8_t> & response) {
+    if (request.wire > RPC_WIRE_Q8_0 || request.tensor.type != GGML_TYPE_F32 ||
+        !rpc_wire_ok(request.wire, request.size, request.tensor.ne[0])) {
+        GGML_LOG_ERROR("[%s] cannot encode tensor (type %u, ne0=%u, size=%" PRIu64 ") as wire mode %u\n",
+                       __func__, request.tensor.type, request.tensor.ne[0], request.size, request.wire);
+        return false;
+    }
+    rpc_msg_get_tensor_req raw_req;
+    raw_req.tensor = request.tensor;
+    raw_req.offset = request.offset;
+    raw_req.size   = request.size;
+    std::vector<uint8_t> raw;
+    if (!get_tensor(raw_req, raw)) {
+        return false;
+    }
+    response.resize(rpc_wire_encoded_size(request.wire, raw.size()));
+    rpc_wire_encode(request.wire, raw.data(), raw.size(), response.data());
+    return true;
+}
+
+// v8.1: | rpc_tensor | offset (8) | wire (1) | raw_size (8) | encoded | -- expands the payload
+// back to F32 into a v8.0-format SET_TENSOR buffer and hands that to set_tensor(), so the bounds
+// checks and the write are shared with the raw path instead of duplicated.
+bool rpc_server::set_tensor_wire(const std::vector<uint8_t> & input) {
+    if (input.size() < RPC_SET_TENSOR_WIRE_HDR) {
+        return false;
+    }
+    const rpc_tensor * in_tensor = (const rpc_tensor *) input.data();
+    const uint8_t * p = input.data() + sizeof(rpc_tensor);
+    uint64_t offset;
+    memcpy(&offset, p, sizeof(offset)); p += sizeof(offset);
+    const uint8_t wire = *p++;
+    uint64_t raw_size;
+    memcpy(&raw_size, p, sizeof(raw_size)); p += sizeof(raw_size);
+    const size_t enc_size = input.size() - RPC_SET_TENSOR_WIRE_HDR;
+    if (wire > RPC_WIRE_Q8_0 || in_tensor->type != GGML_TYPE_F32 || !rpc_wire_ok(wire, raw_size, in_tensor->ne[0]) ||
+        enc_size != rpc_wire_encoded_size(wire, raw_size)) {
+        GGML_LOG_ERROR("[%s] bad wire=%u raw_size=%" PRIu64 " enc_size=%zu for tensor type %u ne0=%u\n",
+                       __func__, wire, raw_size, enc_size, in_tensor->type, in_tensor->ne[0]);
+        return false;
+    }
+    // rebuild as a v8.0 SET_TENSOR payload: | rpc_tensor | offset (8) | raw data (raw_size bytes) |
+    std::vector<uint8_t> raw_input(sizeof(rpc_tensor) + sizeof(offset) + raw_size);
+    memcpy(raw_input.data(), in_tensor, sizeof(rpc_tensor));
+    memcpy(raw_input.data() + sizeof(rpc_tensor), &offset, sizeof(offset));
+    rpc_wire_decode(wire, p, raw_input.data() + sizeof(rpc_tensor) + sizeof(offset), raw_size);
+    return set_tensor(raw_input);
+}
