+void rpc_server::store_graph(uint32_t device, uint64_t uid, std::vector<uint8_t> && buffer, ggml_cgraph * graph) {
+    auto & graphs = stored_graphs_per_device[device];
+    if (graphs.size() >= RPC_GRAPH_UID_CACHE_SIZE) {
