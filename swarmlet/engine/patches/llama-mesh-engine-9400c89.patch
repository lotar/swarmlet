+bool rpc_server::wait_inbound(const rpc_msg_wait_inbound_req & request) {
+    if (peer_hub == nullptr) {
+        GGML_LOG_ERROR("[%s] server was not started with --peer support\n", __func__);
+        return false;
+    }
+
+    rpc_peer_hub::inbox_entry entry;
+    STRACE_MSG("srv=%p wait_inbound begin seq=%" PRIu64 "\n", (void *) this, request.seq);
+    const double t_wait0 = rpc_now_s();
+    if (!peer_hub->wait_and_take(request.seq, entry)) {
+        GGML_LOG_ERROR("[%s] timed out waiting for inbound seq %" PRIu64 "\n", __func__, request.seq);
+        return false;
+    }
+    STRACE_MSG("srv=%p wait_inbound satisfied seq=%" PRIu64 " bytes=%zu blocked_ms=%.3f\n", (void *) this, request.seq, entry.data.size(), (rpc_now_s() - t_wait0) * 1e3);
+
+    // `entry.dst` is in THIS server's own buffer namespace (see ggml_backend_rpc_cpy_tensor_async,
+    // which serializes it with the destination dispatcher before the source server ever sees it
+    // -- the source server only relayed it verbatim in the PUSH_TENSOR payload). Deserialize and
+    // bounds-check exactly like set_tensor() does.
+    struct ggml_init_params params {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_context * ctx = ctx_ptr.get();
+    ggml_tensor * tensor = deserialize_tensor(ctx, &entry.dst);
+    if (tensor == nullptr || tensor->buffer == nullptr) {
+        GGML_LOG_ERROR("[%s] error deserializing dst tensor (seq %" PRIu64 ")\n", __func__, request.seq);
+        return false;
+    }
+    const size_t size = entry.data.size();
+    LOG_DBG("[%s] seq: %" PRIu64 ", buffer: %p, data: %p, size: %zu\n",
+            __func__, request.seq, (void*)tensor->buffer, tensor->data, size);
+
+    {
+        const size_t p0 = (size_t) ggml_backend_buffer_get_base(tensor->buffer);
+        const size_t p1 = p0 + ggml_backend_buffer_get_size(tensor->buffer);
+        if (entry.dst.data < p0 || entry.dst.data >= p1 || size > (p1 - entry.dst.data)) {
+            GGML_LOG_ERROR("[%s] dst tensor region (data=0x%" PRIx64 ", size=%zu) out of buffer bounds [0x%zx, 0x%zx) (seq %" PRIu64 ")\n",
+                           __func__, entry.dst.data, size, p0, p1, request.seq);
+            return false;
+        }
+    }
+
+    ggml_backend_tensor_set(tensor, entry.data.data(), 0, size);
+    return true;
+}
