+    if (!send_msg(sock, &rsp, sizeof(rsp))) {
+        return;
+    }
+    sock->update_caps(req.conn_caps);
+
+    while (true) {
+        if (!sock->recv_data(&cmd, 1)) {
+            return;
+        }
+        const double t_first_byte = rpc_server_trace_enabled() ? rpc_now_s() : 0.0;
+        if (cmd != RPC_CMD_PUSH_TENSOR && cmd != RPC_CMD_PUSH_TENSOR_WIRE) {
+            GGML_LOG_ERROR("[peer listener] unexpected cmd %d on peer connection (only PUSH_TENSOR/PUSH_TENSOR_WIRE are valid)\n", cmd);
+            return;
+        }
+        std::vector<uint8_t> input;
+        if (!recv_msg(sock, input)) {
+            return;
+        }
+        if (rpc_server_trace_enabled()) {
+            // seq is the first 8 bytes of every PUSH payload; recv_ms = first byte of the header to
+            // last byte of the payload, i.e. how long the push took to arrive on this socket
+            uint64_t seq_peek = 0;
+            if (input.size() >= sizeof(seq_peek)) {
+                memcpy(&seq_peek, input.data(), sizeof(seq_peek));
+            }
+            STRACE_MSG("peer=%p push_recv cmd=%d seq=%" PRIu64 " bytes=%zu recv_ms=%.3f\n",
+                       (void *) sock.get(), (int) cmd, seq_peek, input.size(), (rpc_now_s() - t_first_byte) * 1e3);
+        }
+        if (input.size() < sizeof(uint64_t) + sizeof(rpc_tensor)) {
+            GGML_LOG_ERROR("[peer listener] PUSH_TENSOR payload too small\n");
+            return;
+        }
+        const uint8_t * p = input.data();
+        uint64_t seq;
+        memcpy(&seq, p, sizeof(seq)); p += sizeof(seq);
+        rpc_tensor dst;
+        memcpy(&dst, p, sizeof(dst)); p += sizeof(dst);
+        rpc_peer_hub::inbox_entry entry;
+        entry.dst = dst;
+        if (cmd == RPC_CMD_PUSH_TENSOR) {
+            size_t data_size = input.size() - sizeof(seq) - sizeof(dst);
+            entry.data.assign(p, p + data_size);
+        } else {
+            // v8.1: | wire (1) | raw_size (8) | encoded | -- expanded to F32 right here on the
+            // listener thread, so wait_inbound() keeps applying plain raw bytes exactly as it
+            // does for a PUSH_TENSOR.
+            if (input.size() < sizeof(seq) + sizeof(dst) + sizeof(uint8_t) + sizeof(uint64_t)) {
+                GGML_LOG_ERROR("[peer listener] PUSH_TENSOR_WIRE payload too small\n");
+                return;
+            }
+            const uint8_t wire = *p++;
+            uint64_t raw_size;
+            memcpy(&raw_size, p, sizeof(raw_size)); p += sizeof(raw_size);
+            const size_t enc_size = input.size() - (size_t) (p - input.data());
+            if (wire > RPC_WIRE_Q8_0 || dst.type != GGML_TYPE_F32 || !rpc_wire_ok(wire, raw_size, dst.ne[0]) ||
+                enc_size != rpc_wire_encoded_size(wire, raw_size)) {
+                GGML_LOG_ERROR("[peer listener] PUSH_TENSOR_WIRE: bad wire=%u raw_size=%" PRIu64 " enc_size=%zu for tensor type %u ne0=%u\n",
+                               wire, raw_size, enc_size, dst.type, dst.ne[0]);
+                return;
+            }
+            entry.data.resize(raw_size);
+            rpc_wire_decode(wire, p, entry.data.data(), raw_size);
+        }
+        hub->deposit(seq, std::move(entry));
+        // no reply on peer connections -- loop straight back to the next PUSH_TENSOR
+    }
+}
