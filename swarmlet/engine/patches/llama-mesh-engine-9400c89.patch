+// Client-side decision for one transfer of `size` bytes at `offset` of `tensor` to/from a server
+// whose HELLO advertised protocol minor `server_minor`. RPC_WIRE_RAW means "use the v8.0 command".
+static uint8_t rpc_wire_pick(uint8_t server_minor, const ggml_tensor * tensor, size_t offset, size_t size) {
+    const uint8_t want = rpc_wire_env();
+    if (want == RPC_WIRE_RAW || server_minor < RPC_PROTO_MINOR_WIRE) {
+        return RPC_WIRE_RAW;
+    }
+    if (tensor == nullptr || tensor->type != GGML_TYPE_F32 || size < RPC_WIRE_MIN_BYTES) {
+        return RPC_WIRE_RAW;
