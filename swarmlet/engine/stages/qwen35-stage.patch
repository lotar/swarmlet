+// Qwen35 native stages retain Q8_0 weight bytes but use F32 activations and accumulation.
+// Tile output rows so the 248320-row vocabulary head never allocates a full F32 copy.
+static void ggml_cuda_mul_mat_q8_f32(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_ASSERT(src0->type == GGML_TYPE_Q8_0 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(src0) && ggml_is_contiguous(dst) && src1->nb[0] == sizeof(float));
+    constexpr int64_t max_tile_elements = 8LL*1024*1024; // 32 MiB maximum dequantization workspace.
+    const int64_t columns = src0->ne[0];
+    const int64_t tile_rows = std::min(src0->ne[1], std::max<int64_t>(1, max_tile_elements/columns));
+    ggml_cuda_pool_alloc<float> weights(ctx.pool(), tile_rows*columns);
+    const to_fp32_cuda_t dequantize = ggml_get_to_fp32_cuda(GGML_TYPE_Q8_0);
+    const float alpha = 1.0f, beta = 0.0f;
+    cublasHandle_t handle = ctx.cublas_handle();
+    cublasMath_t previous_math;
+    CUBLAS_CHECK(cublasGetMathMode(handle, &previous_math));
+    CUBLAS_CHECK(cublasSetMathMode(handle, CUBLAS_PEDANTIC_MATH));
+    for (int64_t first = 0; first < src0->ne[1]; first += tile_rows) {
+        const int64_t rows = std::min(tile_rows, src0->ne[1] - first);
+        dequantize((const char *) src0->data + first*src0->nb[1], weights.get(), rows*columns, ctx.stream());
+        CUBLAS_CHECK(cublasSgemm(handle, CUBLAS_OP_T, CUBLAS_OP_N,
+            rows, src1->ne[1], columns, &alpha, weights.get(), columns,
+            (const float *) src1->data, src1->nb[1]/sizeof(float), &beta,
+            (float *) dst->data + first, dst->ne[0]));
+    }
+    CUBLAS_CHECK(cublasSetMathMode(handle, previous_math));
+}
