# --- heavy/regenerable runtime artifacts: never committed ---
models/
dist/
sin-harness/data/
sin-harness/*.log
sin-harness/*.pid

# signing keys NEVER leave the machine (even into local git history)
**/keys/

# Dependency/runtime noise
**/node_modules/
**/.venv/
__pycache__/
*.py[cod]

# OS noise
.DS_Store

# per-node L1 instances are their own git repos (created by scripts/init.ts)
sin-harness/knowledge/

# dockerized-node runtime artifacts (per-node sqlite/knowledge clones)
sin-harness/data-docker/
.gstack/

# swarmlet product surface: engine checkouts/builds and build logs are regenerable
swarmlet/engine/.build/
swarmlet/engine/build-*.log
swarmlet/**/*.log
