/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' mailto:; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate
